{
  "name": "autostock",
  "version": "1.0.0",
  "type": "commonjs",
  "dependencies": {
    "@cap-js/postgres": "^3",
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-autostock": "cds watch --open autostock/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/autostock"
  ],
  "cds": {
    "requires": {
      "[production]": {
        "db": "postgres",
        "auth": "dummy"
      },
      "[development]": {
        "db": "sqlite"
      }
    }
  }
}
